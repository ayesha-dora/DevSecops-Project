# Copy this file to `.env` and fill in real values for your environment. NEVER commit `.env` — it is already
# excluded by .gitignore. Every value below is a placeholder; none of these are real credentials.

# ── Application (app/app.py) ────────────────────────────────────────────────
# Path to the SQLite database file used by the sample app. Defaults to /tmp/users.db if unset (fine for local
# demo/testing; for anything longer-lived, point this at a persistent volume).
APP_DB=/data/users.db

# API key required on POST /users (the only state-changing endpoint) via the "X-API-Key" request header.
# If left UNSET, the app runs in "dev mode" for that endpoint (no auth) and logs a warning on every write —
# do not leave this unset outside local development. Generate one with: openssl rand -hex 32
APP_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Python logging level for the app's structured request logs.
LOG_LEVEL=INFO

# ── AI / LLM pipeline stages (ai-agents/*.py) ───────────────────────────────
# Hostname of the MLflow tracking server. Default is "mlflow" — the docker-compose service DNS name — because
# ai-agents/mlflow_logger.py runs inside the Jenkins container, which shares the "devsecops" compose network
# with the mlflow service. Override to "localhost" if you run the script directly on the host instead of
# inside a container, or to "host.docker.internal" for a differently-shaped setup (docker-compose.yml's
# jenkins service sets the extra_hosts entry that name needs to resolve on Linux).
MLFLOW_HOST=mlflow

# How long (seconds) ai-agents/mlflow_logger.py will wait to reach the MLflow tracking server before skipping
# MLflow logging for that run rather than hanging the pipeline stage.
MLFLOW_CONNECT_TIMEOUT_SECONDS=10

# Jenkins build number, used to tag MLflow run names. Jenkins sets this automatically; only set it manually
# when running the AI scripts outside Jenkins.
BUILD_NUMBER=local

# Pin the exact Hugging Face model revision (a specific commit hash from the model's "Files and versions" tab)
# used by ai-agents/hf_code_analyzer.py. If unset, the script defaults to "main" and prints a warning, because
# "main" is a moving target — see ai-agents/requirements.txt and docs/SECURITY.md for why this matters.
HF_MODEL_REVISION=CHANGE_ME_pin_a_specific_commit_hash

# ── docker-compose.yml services ─────────────────────────────────────────────
# Grafana admin credentials. The image's own default ("admin"/"admin") and this repo's previous hardcoded
# default ("admin123") are both publicly known — always override for anything beyond a fully offline laptop
# demo. docker-compose.yml reads these via ${GRAFANA_ADMIN_USER}/${GRAFANA_ADMIN_PASSWORD}.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_do_not_use_the_default

# ── CI/CD tool credentials (referenced by README.md / Jenkinsfile, NOT read directly by app code) ──────────
# Snyk auth token, required for `snyk test`/`snyk monitor` against private data or higher rate limits. Public
# advisory-only scans can run without it but may be rate-limited.
SNYK_TOKEN=CHANGE_ME_snyk_token

# SonarQube server URL and an analysis token (project-scoped, not your personal SonarQube password) for the
# `sonar-scanner` Jenkins stage.
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=CHANGE_ME_sonarqube_project_token

# Optional. Set both to let the Jenkinsfile's "Deploy to Kubernetes" stage do a REAL deploy: it pushes the
# just-built image to Docker Hub, then runs `helm upgrade --install` against whatever cluster the Jenkins
# container's mounted kubeconfig points at (see docs/EC2_DEPLOYMENT_GUIDE.md). Leave both unset and that stage
# skips the real deploy with a clear message rather than silently doing nothing — see CONTEXT.md Change #12.
DOCKERHUB_USERNAME=CHANGE_ME_dockerhub_username
DOCKERHUB_TOKEN=CHANGE_ME_dockerhub_access_token
